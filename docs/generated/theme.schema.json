    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topbar": {
          "type": "string",
          "enum": ["glass", "ledger"],
          "description": "Glass bar with the page title, or a ledger bar with the current section."
        },
        "navigation": {
          "type": "string",
          "enum": ["plain", "numbered"],
          "description": "Plain section list, or numbered chapters."
        },
        "sectionTitle": {
          "type": "string",
          "enum": ["plain", "rule", "bar"],
          "description": "Section title without a rule, underlined, or with a side bar."
        },
        "cards": {
          "type": "string",
          "enum": ["raised", "ruled"],
          "description": "Raised cards, or cards ruled by an accent line."
        },
        "components": {
          "type": "string",
          "enum": ["soft", "flat", "edged"],
          "description": "Soft components, flat framed components, or components with a signal edge."
        },
        "landing": {
          "type": "string",
          "enum": ["centered", "ledger"],
          "description": "Landing opening centred, or a ledger with a side rail and an eyebrow."
        },
        "edges": {
          "type": "string",
          "enum": ["none", "mono"],
          "description": "Nothing at the screen edges, or small monospace captions along them on a wide screen: the page title on the left, the current chapter and its number on the right — for a technical product."
        }
      },
      "description": "How the package draws the shell and shared components."
    },
    "ornaments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headingPrefix": {
          "type": "string",
          "pattern": "^\\s*(?:|(?=(?:[^\\s<\"'\\\\]{0,3})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,1}\\S))\\s*$",
          "description": "Up to three characters drawn before the page heading in the accent colour, such as > or §; no spaces, quotes, backslash or <; empty for none."
        },
        "titleCursor": {
          "type": "boolean",
          "description": "Cursor after the page heading: blinks six times, then stays lit; still under reduced motion."
        },
        "heroEmphasis": {
          "type": "string",
          "enum": ["none", "rule", "shadow"],
          "description": "Hero and story sections unmarked, marked by a thin accent rule, or lifted by a shadow."
        },
        "mediaTreatment": {
          "type": "string",
          "enum": ["plain", "vivid"],
          "description": "Plain images, or images with depth and slightly richer colour."
        },
        "console": {
          "type": "string",
          "enum": ["none", "on"],
          "description": "Console details: bracketed labels, dashed rules and a prompt mark at the current contents item."
        },
        "scanlines": {
          "type": "string",
          "enum": ["none", "on"],
          "description": "Faint scanlines over the whole page; off by default, because a texture over the text reads as a generated-site cliché."
        },
        "glow": {
          "type": "string",
          "enum": ["none", "on"],
          "description": "Phosphor glow on headings and the primary action; off by default for the same reason."
        },
        "linkedCard": {
          "type": "string",
          "enum": ["raised", "edge"],
          "description": "Linked cards raised on hover, or marked by an accent edge."
        }
      },
      "description": "Small signature details of the theme."
    }
