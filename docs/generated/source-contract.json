{
  "contractVersion": 1,
  "source": {
    "entry": "Markdown file or directory containing report.md/index.md",
    "metadata": ["YAML/JSON manifest", "YAML frontmatter"],
    "partialSyntax": "{{include: relative/path.md}}",
    "directiveSyntax": {
      "container": ":::name{attributes}\nMarkdown children\n:::",
      "nestedContainer": "Use a longer outer colon fence than nested directives.",
      "leaf": "::name{attributes}",
      "text": ":name[label]{attributes}"
    },
    "resources": ["local images", "downloadable local assets", "local fonts"]
  },
  "directives": {
    "section": {
      "description": "Labelled top-level page section containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": true,
          "description": "Visible title."
        },
        "id": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "required": false,
          "description": "Optional stable section anchor."
        },
        "nav": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": false,
          "description": "Optional short primary-navigation label."
        },
        "width": {
          "kind": "enum",
          "values": ["reading", "standard", "wide"],
          "required": false,
          "default": "standard",
          "description": "Section content track."
        },
        "align": {
          "kind": "enum",
          "values": ["start", "center"],
          "required": false,
          "default": "start",
          "description": "Section content alignment."
        },
        "tone": {
          "kind": "enum",
          "values": ["plain", "soft", "accent", "contrast"],
          "required": false,
          "default": "plain",
          "description": "Package-owned section surface tone."
        },
        "reveal": {
          "kind": "boolean",
          "required": false,
          "default": false,
          "description": "Enables one package-owned one-time section reveal in the normal-motion profile."
        }
      },
      "children": "markdown",
      "placement": { "topLevelOnly": true },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "actions": {
      "description": "Responsive group containing ordinary action links.",
      "forms": ["container"],
      "attributes": {},
      "children": "action-directives",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "action": {
      "description": "Ordinary safe link inside an actions group.",
      "forms": ["leaf"],
      "attributes": {
        "href": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?:#[A-Za-z][A-Za-z0-9_-]{0,127}|https?://[^\\s<>]+|mailto:[^\\s<>]+|(?!(?:[A-Za-z][A-Za-z0-9+.-]*:|//|/))[A-Za-z0-9.][^\\s<>\\\\]*)$",
          "required": true,
          "description": "Safe same-page, relative, HTTP(S), or email link target; executable and local-file schemes are rejected."
        },
        "kind": {
          "kind": "enum",
          "values": ["primary", "secondary", "quiet"],
          "required": false,
          "default": "primary",
          "description": "Package-owned action emphasis."
        }
      },
      "children": "label-or-generated-label",
      "placement": { "requiredParent": "actions" },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "callout": {
      "description": "Emphasized finding or notice containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
          "description": "Visible title."
        },
        "kind": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "required": false,
          "default": "info",
          "description": "Lowercase presentation token."
        }
      },
      "children": "markdown",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "decision": {
      "description": "Decision or product-development branch containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
          "description": "Visible title."
        }
      },
      "children": "markdown",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "cards": {
      "description": "Responsive grid, normally containing card directives.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
          "description": "Visible title."
        }
      },
      "children": "markdown-and-card-directives",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "card": {
      "description": "One semantic card containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
          "description": "Visible title."
        }
      },
      "children": "markdown",
      "placement": { "requiredParent": "cards", "preferredParent": "cards" },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "steps": {
      "description": "Process or tutorial sequence containing Markdown, normally an ordered list.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
          "description": "Visible title."
        }
      },
      "children": "markdown",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "glossary": {
      "description": "Reusable glossary definition containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "key": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "required": true,
          "description": "Stable glossary definition key."
        },
        "term": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": true,
          "description": "Canonical term text inserted at every reference."
        }
      },
      "children": "markdown",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document", "reader-runtime"]
    },
    "term": {
      "description": "Inline or standalone reference that opens a registered glossary explanation.",
      "forms": ["leaf", "text"],
      "attributes": {
        "key": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "required": true,
          "description": "Key of the glossary definition to reference."
        }
      },
      "children": "label-or-generated-label",
      "placement": {},
      "resource": "none",
      "runtime": "glossary-reference",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document", "reader-runtime"]
    },
    "disclosure": {
