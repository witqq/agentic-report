    },
    "series": {
      "description": "One named chart series containing data points.",
      "forms": ["container"],
      "attributes": {
        "label": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": true,
          "description": "Legend label."
        }
      },
      "children": "point-directives",
      "placement": { "requiredParent": "chart" },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "point": {
      "description": "One labelled numeric value in a chart series.",
      "forms": ["leaf"],
      "attributes": {
        "label": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": true,
          "description": "Category label."
        },
        "value": {
          "kind": "number",
          "minimum": -999999999,
          "maximum": 999999999,
          "multipleOf": 0.0001,
          "lexicalPattern": "^-?(?:0|[1-9]\\d{0,8})(?:\\.\\d{1,4})?$",
          "required": true,
          "description": "Finite numeric value between -999999999 and 999999999."
        }
      },
      "children": "none",
      "placement": { "requiredParent": "series" },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
