{
  "contractVersion": 1,
  "source": {
    "entry": "Markdown file or directory containing report.md/index.md",
    "metadata": ["YAML/JSON manifest", "YAML frontmatter"],
    "partialSyntax": "{{include: relative/path.md}}",
    "directiveSyntax": {
      "container": ":::name{attributes}\nMarkdown children\n:::",
      "nestedContainer": "Use a longer outer colon fence than nested directives.",
      "leaf": "::name{attributes}",
      "text": ":name[label]{attributes}",
      "numericColonText": "Two- or three-part numeric time/duration tokens such as 21:01 and 1:30:05 remain literal Markdown text."
    },
    "codeFenceMetadata": {
      "terms": {
        "syntax": "terms=\"key,other-key\"",
        "description": "Annotates exact first canonical glossary occurrences in one code fence.",
        "fieldExclusivity": "only-field",
        "quoting": "double",
        "separator": ",",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "itemConstraint": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "matching": {
          "source": "canonical-glossary-term",
          "caseSensitive": true,
          "occurrence": "first",
          "lineBoundary": "reject",
          "overlap": "reject"
        }
      }
    },
    "resources": ["local images", "downloadable local assets", "local fonts"]
  },
  "directives": {
    "section": {
      "description": "Labelled top-level page section containing Markdown.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": true,
          "description": "Visible title."
        },
        "id": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "required": false,
          "description": "Optional stable section anchor."
        },
        "nav": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": false,
          "description": "Optional short primary-navigation label."
        },
        "width": {
          "kind": "enum",
          "values": ["reading", "standard", "wide"],
          "required": false,
          "default": "standard",
          "description": "Section content track."
        },
        "align": {
          "kind": "enum",
          "values": ["start", "center"],
          "required": false,
          "default": "start",
          "description": "Section content alignment."
        },
        "tone": {
          "kind": "enum",
          "values": ["plain", "soft", "accent", "contrast"],
          "required": false,
          "default": "plain",
          "description": "Package-owned section surface tone."
        },
        "reveal": {
          "kind": "boolean",
          "required": false,
          "default": false,
          "description": "Enables one package-owned one-time section reveal in the normal-motion profile."
        }
      },
      "children": "markdown",
      "placement": { "topLevelOnly": true },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "actions": {
      "description": "Responsive group containing ordinary action links.",
      "forms": ["container"],
      "attributes": {},
      "children": "action-directives",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "action": {
      "description": "Ordinary safe link inside an actions group.",
      "forms": ["leaf"],
      "attributes": {
        "href": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?:#[A-Za-z][A-Za-z0-9_-]{0,127}|https?://[^\\s<>]+|mailto:[^\\s<>]+|(?!(?:[A-Za-z][A-Za-z0-9+.-]*:|//|/))[A-Za-z0-9.][^\\s<>\\\\]*)$",
          "required": true,
          "description": "Safe same-page, relative, HTTP(S), or email link target; executable and local-file schemes are rejected."
        },
        "kind": {
          "kind": "enum",
          "values": ["primary", "secondary", "quiet"],
          "required": false,
          "default": "primary",
          "description": "Package-owned action emphasis."
        }
      },
      "children": "label-or-generated-label",
      "placement": { "requiredParent": "actions" },
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
    "source-link": {
      "description": "Source location opened through an explicit IPv4 loopback editor helper without replacing the report page.",
      "forms": ["text"],
      "attributes": {
        "label": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": true,
          "description": "Short visible source path and line."
        },
        "href": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/open\\?path=(?:%2[Ff]|/)[^\\s<>&#]+&line=[1-9][0-9]{0,8}$",
          "required": true,
          "description": "IPv4 loopback editor-helper URL with an absolute path and positive source line."
        }
      },
      "children": "none",
      "placement": {},
      "resource": "none",
      "runtime": "none",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document"]
    },
