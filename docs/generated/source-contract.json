        },
        "label": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 160,
          "required": true,
          "description": "Visible switch label."
        },
        "default": {
          "kind": "enum",
          "values": ["off", "on"],
          "required": false,
