          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 300,
          "required": true,
          "description": "Meaningful plain-text description for the visual."
        },
        "type": {
          "kind": "enum",
          "values": ["bar", "line", "pie"],
