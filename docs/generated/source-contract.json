      "resource": "none",
      "runtime": "package-owned-popover",
      "security": { "authorCode": false, "rawHtml": false, "localResourceOnly": false },
      "handoffs": ["semantic-document", "reader-runtime"]
    },
    "filter": {
      "description": "Client-side text filter for authored list items.",
      "forms": ["container"],
      "attributes": {
        "title": {
          "kind": "string",
          "normalization": "trim",
          "minLength": 1,
          "maxLength": 200,
          "required": false,
