{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-report:schema:extension-proposal:1",
  "title": "Agentic Report extension proposal gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "summary", "trustBoundary", "evidence"],
  "properties": {
    "contractVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "summary": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorCode",
        "callbacks",
        "eval",
        "dynamicImports",
        "networkAccess",
        "confinement",
        "offline",
        "deterministicSerialization",
        "cspCompatible",
        "packageOwnedRuntime"
      ],
      "properties": {
        "authorCode": { "const": "forbidden" },
        "callbacks": { "const": "forbidden" },
        "eval": { "const": "forbidden" },
        "dynamicImports": { "const": "forbidden" },
        "networkAccess": { "const": "forbidden" },
        "confinement": { "const": "source-root" },
        "offline": { "const": "required" },
        "deterministicSerialization": { "const": "required" },
        "cspCompatible": { "const": "required" },
        "packageOwnedRuntime": { "const": "required" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceGrammar",
        "executionCapabilities",
        "confinement",
        "offlineBehavior",
        "deterministicSerialization",
        "cspAndRuntime",
        "accessibility",
        "byteAndPerformanceBudgets",
        "packageDependenciesAndLicenses",
        "compatibility"
      ],
      "properties": {
        "sourceGrammar": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
        "executionCapabilities": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S[\\s\\S]{18,}\\S"
        },
        "confinement": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
        "offlineBehavior": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
        "deterministicSerialization": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S[\\s\\S]{18,}\\S"
        },
        "cspAndRuntime": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
        "accessibility": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" },
        "byteAndPerformanceBudgets": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S[\\s\\S]{18,}\\S"
        },
        "packageDependenciesAndLicenses": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S[\\s\\S]{18,}\\S"
        },
        "compatibility": { "type": "string", "minLength": 20, "pattern": "\\S[\\s\\S]{18,}\\S" }
      }
    }
  }
}
