{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-report:schema:directives:1",
  "title": "Agentic Report directive invocation",
  "x-agentic-report-contract": {
    "currentMajor": 1,
    "supportedReaderMajors": [1],
    "legacySourceMajor": 1,
    "evolution": {
      "additiveWithinMajor": true,
      "breakingChangeRequiresNewMajor": true,
      "silentReinterpretationAllowed": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/section" },
    { "$ref": "#/$defs/actions" },
    { "$ref": "#/$defs/action" },
    { "$ref": "#/$defs/callout" },
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/decision-option" },
    { "$ref": "#/$defs/checklist" },
    { "$ref": "#/$defs/check-item" },
    { "$ref": "#/$defs/cards" },
    { "$ref": "#/$defs/card" },
    { "$ref": "#/$defs/steps" },
    { "$ref": "#/$defs/glossary" },
    { "$ref": "#/$defs/term" },
    { "$ref": "#/$defs/disclosure" },
    { "$ref": "#/$defs/tabs" },
    { "$ref": "#/$defs/tab" },
    { "$ref": "#/$defs/modal" },
    { "$ref": "#/$defs/popover" },
    { "$ref": "#/$defs/filter" },
    { "$ref": "#/$defs/toggle" },
    { "$ref": "#/$defs/chart" },
    { "$ref": "#/$defs/series" },
    { "$ref": "#/$defs/point" },
    { "$ref": "#/$defs/diagram" },
    { "$ref": "#/$defs/node" },
    { "$ref": "#/$defs/edge" },
    { "$ref": "#/$defs/timeline" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/demo" },
    { "$ref": "#/$defs/asset" },
    { "$ref": "#/$defs/font" }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "section" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Optional stable section anchor."
            },
            "nav": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Optional short primary-navigation label."
            },
            "width": {
              "type": "string",
              "enum": ["reading", "standard", "wide"],
              "description": "Section content track.",
              "default": "standard"
            },
            "align": {
              "type": "string",
              "enum": ["start", "center"],
              "description": "Section content alignment.",
              "default": "start"
            },
            "tone": {
              "type": "string",
              "enum": ["plain", "soft", "accent", "contrast"],
              "description": "Package-owned section surface tone.",
              "default": "plain"
            },
            "reveal": {
              "type": "boolean",
              "description": "Enables one package-owned one-time section reveal in the normal-motion profile.",
              "default": false
            }
          },
          "required": ["title"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "actions" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": { "type": "object", "additionalProperties": false, "properties": {} }
      },
      "required": ["name", "form", "attributes"]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "action" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:(?:#[A-Za-z][A-Za-z0-9_-]{0,127}|https?://[^\\s<>]+|mailto:[^\\s<>]+|(?!(?:[A-Za-z][A-Za-z0-9+.-]*:|//|/))[A-Za-z0-9.][^\\s<>\\\\]*))(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,498}\\S))\\s*$",
              "description": "Safe same-page, relative, HTTP(S), or email link target; executable and local-file schemes are rejected."
            },
            "kind": {
              "type": "string",
              "enum": ["primary", "secondary", "quiet"],
              "description": "Package-owned action emphasis.",
              "default": "primary"
            }
          },
          "required": ["href"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "callout" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "kind": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,31})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,30}\\S))\\s*$",
              "description": "Lowercase presentation token.",
              "default": "info"
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "decision" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Stable identity required when decision options are authored."
            },
            "required": {
              "type": "boolean",
              "description": "Requires a selected, open, or deferred response.",
              "default": false
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "decision-option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "decision-option" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Stable option identity."
            },
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible option label."
            }
          },
          "required": ["id", "label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "checklist" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Stable checklist identity."
            }
          },
          "required": ["title", "id"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "check-item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "check-item" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Stable checklist item identity."
            },
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible checklist item label."
            },
            "required": {
              "type": "boolean",
              "description": "Blocks approval while unchecked.",
              "default": false
            }
          },
          "required": ["id", "label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "cards" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "card" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "steps" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "glossary" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Stable glossary definition key."
            },
            "term": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Canonical term text inserted at every reference."
            }
          },
          "required": ["key", "term"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "term" },
        "form": { "type": "string", "enum": ["leaf", "text"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Key of the glossary definition to reference."
            }
          },
          "required": ["key"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "disclosure" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "open": {
              "type": "string",
              "enum": ["false", "true"],
              "description": "Initial disclosure state.",
              "default": "false"
            }
          },
          "required": ["title"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "tabs" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "tab" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible tab label."
            }
          },
          "required": ["label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "modal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "modal" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "trigger": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible dialog trigger label.",
              "default": "Open dialog"
            }
          },
          "required": ["title"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "popover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "popover" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "trigger": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible popover trigger label.",
              "default": "Show details"
            }
          },
          "required": ["title"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "filter" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "placeholder": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Search-field placeholder.",
              "default": "Filter items"
            }
          }
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "toggle" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible switch label."
            },
            "default": {
              "type": "string",
              "enum": ["off", "on"],
              "description": "Initial switch state.",
              "default": "off"
            }
          },
          "required": ["label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "chart" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "description": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,298}\\S))\\s*$",
              "description": "Meaningful plain-text description for the visual."
            },
            "type": {
              "type": "string",
              "enum": ["bar", "line", "pie"],
              "description": "Chart form.",
              "default": "bar"
            },
            "x-label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Horizontal-axis label."
            },
            "y-label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Vertical-axis label."
            }
          },
          "required": ["title", "description"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "series" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Legend label."
            }
          },
          "required": ["label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "point" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Category label."
            },
            "value": {
              "type": "number",
              "minimum": -999999999,
              "maximum": 999999999,
              "multipleOf": 0.0001,
              "description": "Finite numeric value between -999999999 and 999999999."
            }
          },
          "required": ["label", "value"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "diagram" },
        "form": { "type": "string", "enum": ["container"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,198}\\S))\\s*$",
              "description": "Visible title."
            },
            "description": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,298}\\S))\\s*$",
              "description": "Meaningful plain-text description for the visual."
            },
            "direction": {
              "type": "string",
              "enum": ["right", "down"],
              "description": "Flow direction.",
              "default": "right"
            }
          },
          "required": ["title", "description"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "node" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Unique node identity within the diagram."
            },
            "label": {
              "type": "string",
              "pattern": "^\\s*(?:(?:\\S|\\S[\\s\\S]{0,158}\\S))\\s*$",
              "description": "Visible node label."
            },
            "kind": {
              "type": "string",
              "enum": ["neutral", "accent", "success", "warning"],
              "description": "Package-owned node emphasis.",
              "default": "neutral"
            }
          },
          "required": ["id", "label"]
        }
      },
      "required": ["name", "form", "attributes"]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "const": "edge" },
        "form": { "type": "string", "enum": ["leaf"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\s*(?:(?=(?:[a-z][a-z0-9-]{0,63})(?<!\\s)\\s*$)(?:\\S|\\S[\\s\\S]{0,62}\\S))\\s*$",
              "description": "Source node identity."
